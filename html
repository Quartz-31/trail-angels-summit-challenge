<body><div id="ta-challenge">
<div class="ta-hero"><img decoding="async" src="https://trailangels.co.za/wp-content/uploads/2026/07/header_download.png" alt="Summit for Dignity Challenge"></div>

<div class="ta-header">
  <div class="ta-brand-row">
    <div class="ta-brand-id">
      <div class="ta-logo"><img decoding="async" src="https://trailangels.co.za/wp-content/uploads/2026/07/logo_download.png" alt="Trail Angels"></div>
      <div>
        <div class="ta-brand-name">Trail Angels</div>
        <div class="ta-challenge-name">Summit for <em>Dignity</em> Challenge</div>
      </div>
    </div>
    <a class="ta-btn-strava" id="ta-btn-connect" href="https://trailangels.co.za/trail-angels-strava-connect/">
      <img src="https://trailangels.co.za/wp-content/uploads/2026/07/btn_strava_connect_with_orange_x2.png" alt="Connect with Strava">
    </a>
    <div class="ta-connected" id="ta-connected">
      <div class="ta-connected-av" id="ta-av"></div>
      <div>
        <div class="ta-connected-name" id="ta-name"></div>
        <div class="ta-connected-sub">Connected via Strava</div>
      </div>
      <button class="ta-btn-disc" onclick="taDisconnect()">Disconnect</button>
    </div>
  </div>

  <div class="ta-how-to">
    <div class="ta-how-heading">How to get on the leaderboard</div>
    <div class="ta-steps">

      <div class="ta-step">
        <div class="ta-step-n">1</div>
        <div class="ta-step-t">To get on the leaderboard, compete for sponsored prizes and have your summits count officially — <strong>enter by donating a minimum of R120</strong> to the Menstruation Foundation via our <a href="https://www.givengain.com/project/lena-raising-funds-for-menstruation-foundation-126963" target="_blank" rel="noopener">GivenGain page</a>.</div>
      </div>

      <div class="ta-step">
        <div class="ta-step-n">2</div>
        <div class="ta-step-t">Join our <a href="https://www.strava.com/clubs/537293" target="_blank" rel="noopener">Trail Angels Strava Club</a> to keep up to date with our challenge efforts and community updates.</div>
      </div>

      <div class="ta-step">
        <div class="ta-step-n">3</div>
        <div class="ta-step-t">Click <strong>Connect Strava</strong> above to link your Strava profile to this Virtual Challenge page.</div>
      </div>

      <div class="ta-step">
        <div class="ta-step-n">4</div>
        <div class="ta-step-t">Get out and ride — complete as many <strong>Mast Summits</strong> as you can throughout the month of August.</div>
      </div>

      <div class="ta-step">
        <div class="ta-step-n">5</div>
        <div class="ta-step-t">Every time you upload your ride, your <strong>Trail Angels – Summit for Dignity ❤</strong> segment effort is automatically counted and added to the leaderboard.</div>
      </div>

      <div class="ta-step">
        <div class="ta-step-n">6</div>
        <div class="ta-step-t">Go for the <strong>Yellow Jersey</strong> by clocking the fastest single summit in August — or rack up as many climbs as you can to claim the <strong>Polka Dot Climbers' Jersey</strong>. Either way, every summit counts.</div>
      </div>

      <div class="ta-step">
        <div class="ta-step-n">7</div>
        <div class="ta-step-t ta-step-note">Please note: <strong>ALL efforts count toward our fundraising</strong> — but only <strong>female efforts</strong> will appear on our Women's Month Summit for Dignity Leaderboard.</div>
      </div>

    </div>
  </div>

  <div class="ta-seg-bar">
    <div class="ta-seg-info">
      <div class="ta-seg-icon">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <polyline points="1 20 7 14 13 17 23 7"></polyline><polyline points="17 7 23 7 23 13"></polyline>
        </svg>
      </div>
      <div>
        <div style="display:flex;align-items:baseline;gap:7px">
          <span class="ta-seg-label">Segment:</span>
          <span class="ta-seg-name">Trail Angels – Summit for Dignity ❤</span>
        </div>
        <div class="ta-seg-meta">
          <span class="ta-seg-stat">Table Mountain National Park</span>
          <span class="ta-sep">·</span>
          <a class="ta-seg-link" href="https://www.strava.com/segments/41844407" target="_blank" rel="noopener">View on Strava ↗</a>
        </div>
      </div>
    </div>
    <div class="ta-badge">
      <svg viewBox="0 0 12 12"><path d="M6 1l1.5 3h3l-2.5 2 1 3L6 7.5 3 9l1-3L1.5 4h3z"></path></svg>
      Members Only
    </div>
  </div>
</div>

<div class="ta-content">

  <div class="ta-banner">
    <div class="ta-banner-content">
      <div class="ta-banner-hl">Every summit counts</div>
      <div class="ta-banner-stats">
        <div class="ta-banner-stat">
          <span class="ta-stat-num" id="ta-efforts">0</span>
          <span class="ta-stat-lbl">Summits this month</span>
        </div>
        <div class="ta-banner-div"></div>
        <div class="ta-banner-stat">
          <span class="ta-stat-num pink" id="ta-rands">R0</span>
          <span class="ta-stat-lbl">Raised for the Menstruation Foundation</span>
        </div>
      </div>
    </div>
    <div class="ta-banner-cause"><strong>R10 per summit</strong> + <strong>R120 entry fee</strong> per participant — every rand goes toward sanitary pads for girls who need them.</div>
  </div>

  <div class="ta-month-row">
    <div class="ta-month-info">
      <span class="ta-live">Live</span>
      <span class="ta-month-sep">·</span>
      <span class="ta-month-lbl">August 2026</span>
      <span class="ta-month-sep">·</span>
      <span class="ta-month-range">Aug 1 – Aug 31</span>
    </div>
    <div class="ta-countdown">
      <span class="ta-cd-num" id="ta-days">33</span>
      <span class="ta-cd-txt" id="ta-days-lbl">Days left to<br>make a difference</span>
    </div>
  </div>

  <div class="ta-tabs-wrap">
    <div class="ta-tabs">
      <button class="ta-tab active" id="ta-tab-fastest" onclick="taSwitchTab('fastest')">⚡ Fastest Time</button>
      <button class="ta-tab" id="ta-tab-efforts" onclick="taSwitchTab('efforts')">🏔 Most Efforts</button>
      <button class="ta-tab" id="ta-tab-firsttimers" onclick="taSwitchTab('firsttimers')">🔘 First Timers</button>
    </div>
  </div>

  <div class="ta-panels">
    <div class="ta-panel active" id="ta-panel-fastest">
      <div class="ta-type-toggle" id="ta-fastest-toggle">
        <button class="ta-type-btn active" data-type="analog" onclick="taSwitchFastestType('analog')">Analog</button>
        <button class="ta-type-btn" data-type="ebike" onclick="taSwitchFastestType('ebike')">E-bike</button>
      </div>
      <div class="ta-lb" id="ta-lb-fastest"><div class="ta-empty"><div class="ta-empty-icon">⚡</div><div class="ta-empty-title">No efforts yet</div><div class="ta-empty-sub">Be the first to summit — complete a ride that covers the segment and upload it to Strava.</div></div></div>
    </div>
    <div class="ta-panel" id="ta-panel-efforts">
      <div class="ta-lb" id="ta-lb-efforts"><div class="ta-empty"><div class="ta-empty-icon">🏔</div><div class="ta-empty-title">No summits yet</div><div class="ta-empty-sub">Every ride counts — get out and complete as many Mast Summits as you can this August.</div></div></div>
    </div>
    <div class="ta-panel" id="ta-panel-firsttimers">
      <div class="ta-lb" id="ta-lb-firsttimers"><div class="ta-empty"><div class="ta-empty-icon">🔘</div><div class="ta-empty-title">No first-timers yet</div><div class="ta-empty-sub">When someone completes this segment for the very first time in August, their name will appear here. Could it be yours?</div></div></div>
    </div>
  </div>

</div>

<svg style="display:none">
  <symbol id="ta-jersey-yellow" viewBox="0 0 32 32">
    <path d="M10 8 L6 13 L2 12 L4 18 L8 17 L8 28 L24 28 L24 17 L28 18 L30 12 L26 13 L22 8 Q19 5 16 6 Q13 5 10 8Z" fill="#FFD700"></path>
    <path d="M13 8 Q16 10 19 8 Q18 12 16 13 Q14 12 13 8Z" fill="#e6b800"></path>
    <path d="M10 8 L6 13 L9 14 L13 10Z" fill="#e6b800"></path>
    <path d="M22 8 L26 13 L23 14 L19 10Z" fill="#e6b800"></path>
  </symbol>
  <symbol id="ta-jersey-white" viewBox="0 0 32 32">
    <path d="M10 8 L6 13 L2 12 L4 18 L8 17 L8 28 L24 28 L24 17 L28 18 L30 12 L26 13 L22 8 Q19 5 16 6 Q13 5 10 8Z" fill="#f5f5f5" stroke="#cccccc" stroke-width="0.9"></path>
    <path d="M13 8 Q16 10 19 8 Q18 12 16 13 Q14 12 13 8Z" fill="#e0e0e0"></path>
    <path d="M10 8 L6 13 L9 14 L13 10Z" fill="#e0e0e0"></path>
    <path d="M22 8 L26 13 L23 14 L19 10Z" fill="#e0e0e0"></path>
  </symbol>
  <symbol id="ta-jersey-dots" viewBox="0 0 32 32">
    <path d="M10 8 L6 13 L2 12 L4 18 L8 17 L8 28 L24 28 L24 17 L28 18 L30 12 L26 13 L22 8 Q19 5 16 6 Q13 5 10 8Z" fill="#eee" stroke="#ccc" stroke-width="0.8"></path>
    <path d="M13 8 Q16 10 19 8 Q18 12 16 13 Q14 12 13 8Z" fill="#ddd"></path>
    <circle cx="12" cy="15" r="2" fill="#e00000"></circle>
    <circle cx="20" cy="15" r="2" fill="#e00000"></circle>
    <circle cx="16" cy="20" r="2" fill="#e00000"></circle>
    <circle cx="12" cy="24" r="2" fill="#e00000"></circle>
    <circle cx="20" cy="24" r="2" fill="#e00000"></circle>
    <circle cx="8" cy="13" r="1.5" fill="#e00000"></circle>
    <circle cx="24" cy="13" r="1.5" fill="#e00000"></circle>
  </symbol>
</svg>

<div class="ta-sponsor">
  <div class="ta-sponsor-inner">
    <span class="ta-sponsor-lbl">Proudly supported by</span>
    <div class="ta-sponsor-rule"></div>
    <div class="ta-sponsor-logos">
      <img decoding="async" src="https://trailangels.co.za/wp-content/uploads/2026/07/BB_logo_download.png" alt="Beyond Bike">
    </div>
  </div>
</div>

</div><!-- /#ta-challenge -->

<script>
// ================================================================
// LIVE CONFIGURATION
// ================================================================
var TA_API           = 'https://trail-angels-summit-challenge.onrender.com';
var TA_SESSION_KEY   = 'ta_strava_athlete';
var TA_CHALLENGE_END = new Date('2026-08-31T23:59:59');
// ================================================================

function taCalcRaised(efforts, participants){ return (efforts*10)+(participants*120); }

function taCountdown(){
  var diff = TA_CHALLENGE_END - new Date();
  var el   = document.getElementById('ta-days');
  var lbl  = document.getElementById('ta-days-lbl');
  if(!el) return;
  if(diff <= 0){ el.textContent='0'; lbl.innerHTML='Challenge complete'; return; }
  el.textContent = Math.ceil(diff/(1000*60*60*24));
}

function taAnimate(el, target, prefix){
  var s = null;
  (function step(ts){
    if(!s) s=ts;
    var p=Math.min((ts-s)/1400,1), e=1-Math.pow(1-p,3);
    el.textContent=prefix+Math.round(e*target);
    if(p<1) requestAnimationFrame(step);
  })(performance.now());
}

var TA_COLORS=['#E8317A','#9B59B6','#16A085','#2980B9','#27AE60','#C0392B','#D35400','#8E44AD'];
var taFastestType = 'analog';
function taExtractLB(d){ return Array.isArray(d) ? d : (d && d.leaderboard) || []; }
function taColor(name){ var i=0; for(var j=0;j<(name||'').length;j++) i+=name.charCodeAt(j); return TA_COLORS[i%TA_COLORS.length]; }
function taInitials(f,l){ return ((f||'').charAt(0)+(l||'').charAt(0)).toUpperCase(); }
function taAvHTML(a){ return a.profile ? '<img decoding="async" src="'+a.profile+'" alt="" />' : taInitials(a.firstname,a.lastname); }
function taAvBg(a){ return a.profile ? 'transparent' : taColor(a.firstname); }
function taFirstBadge(a){ return a.is_first_time ? '<span class="ta-first-badge">&#9733; First Summit</span>' : ''; }

function taMkRow(a, jersey, metricHTML){
  var rc = a.rank<=3 ? 'r'+a.rank : '';
  return '<div class="ta-row '+rc+'">'
    +'<div class="ta-rank-col"><span class="ta-rank-n">'+a.rank+'</span>'+jersey+'</div>'
    +'<div class="ta-av" style="background:'+taAvBg(a)+'">'+taAvHTML(a)+'</div>'
    +'<div class="ta-ath">'
    +'<div class="ta-ath-name">'+(a.firstname||'')+' '+(a.lastname||'')+taFirstBadge(a)+'</div>'
    +(a.sub?'<div class="ta-ath-sub">'+a.sub+'</div>':'')
    +'</div>'
    +'<div class="ta-metric">'+metricHTML+'</div>'
    +'</div>';
}

function taRenderFastest(data){
  var c = document.getElementById('ta-lb-fastest');
  if(!data||!data.length){
    c.innerHTML='<div class="ta-empty"><div class="ta-empty-icon">&#9889;</div>'
      +'<div class="ta-empty-title">No efforts yet</div>'
      +'<div class="ta-empty-sub">Be the first to summit &#8212; complete a ride that covers the segment and upload it to Strava.</div></div>';
    return;
  }
  c.innerHTML='';
  data.forEach(function(a){
    var j = a.rank===1 ? '<svg class="ta-jersey"><use href="#ta-jersey-yellow"/></svg>' : '';
    c.innerHTML += taMkRow(a,j,'<div class="ta-metric-main">'+a.best_time+'</div><div class="ta-metric-unit">best time</div>');
  });
}

function taRenderEfforts(data){
  var c = document.getElementById('ta-lb-efforts');
  if(!data||!data.length){
    c.innerHTML='<div class="ta-empty"><div class="ta-empty-icon">&#127956;</div>'
      +'<div class="ta-empty-title">No summits yet</div>'
      +'<div class="ta-empty-sub">Every ride counts &#8212; get out and complete as many Mast Summits as you can this August.</div></div>';
    return;
  }
  c.innerHTML='';
  data.forEach(function(a){
    a.sub = a.effort_count+' effort'+(a.effort_count!==1?'s':'')+' · R'+(a.effort_count*10)+' raised';
    var j = a.rank===1 ? '<svg class="ta-jersey"><use href="#ta-jersey-dots"/></svg>' : '';
    c.innerHTML += taMkRow(a,j,'<div class="ta-metric-main">'+a.effort_count+'</div><div class="ta-metric-unit">summits</div>');
  });
}

function taRenderFirstTimers(data){
  var c = document.getElementById('ta-lb-firsttimers');
  if(!data||!data.length){
    c.innerHTML='<div class="ta-empty"><div class="ta-empty-icon">&#128280;</div>'
      +'<div class="ta-empty-title">No first-timers yet</div>'
      +'<div class="ta-empty-sub">When someone completes this segment for the very first time in August, their name will appear here. Could it be yours?</div></div>';
    return;
  }
  var html = '<div class="ta-ft-header">'
    +'<svg><use href="#ta-jersey-white"/></svg>'
    +'Summiting for the first time this August &#8212; welcome to the climb!'
    +'</div>'
    +'<div style="display:flex;flex-direction:column;gap:6px">';
  data.forEach(function(a){
    var count = a.effort_count || 1;
    var sub   = count > 1 ? count + ' summits this month' : '1 summit this month';
    html += '<div class="ta-ft-row">'
      +'<svg class="ta-ft-jersey"><use href="#ta-jersey-white"/></svg>'
      +'<div class="ta-av" style="background:'+taAvBg(a)+'">'+taAvHTML(a)+'</div>'
      +'<div class="ta-ft-ath">'
      +'<div class="ta-ft-name">'+(a.firstname||'')+' '+(a.lastname||'')+'</div>'
      +'<div class="ta-ft-sub">First ever summit &#10084;</div>'
      +'</div>'
      +'<div class="ta-ft-pill">'+sub+'</div>'
      +'</div>';
  });
  html += '</div>';
  c.innerHTML = html;
}

function taFetchFastest(type){
  var c = document.getElementById('ta-lb-fastest');
  c.innerHTML = '<div class="ta-loading"><div class="ta-spinner"></div><p>Loading leaderboard&#8230;</p></div>';
  fetch(TA_API+'/leaderboard/fastest?type='+type)
    .then(function(r){ return r.ok ? r.json() : []; })
    .then(function(d){ taRenderFastest(taExtractLB(d)); })
    .catch(function(){ taRenderFastest([]); });
}

function taSwitchFastestType(type){
  if(type === taFastestType) return;
  taFastestType = type;
  document.querySelectorAll('#ta-fastest-toggle .ta-type-btn').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-type') === type);
  });
  taFetchFastest(type);
}

function taFetch(){
  var eEl = document.getElementById('ta-efforts');
  var rEl = document.getElementById('ta-rands');
  Promise.all([
    fetch(TA_API+'/leaderboard/fastest?type='+taFastestType).then(function(r){return r.ok?r.json():[];}).then(taExtractLB).catch(function(){return[];}),
    fetch(TA_API+'/leaderboard/efforts').then(function(r){return r.ok?r.json():[];}).catch(function(){return[];}),
    fetch(TA_API+'/stats').then(function(r){return r.ok?r.json():{};}).catch(function(){return{};}),
    fetch(TA_API+'/leaderboard/first-timers').then(function(r){return r.ok?r.json():[];}).catch(function(){return[];})
  ]).then(function(res){
    taRenderFastest(res[0]);
    taRenderEfforts(res[1]);
    taRenderFirstTimers(res[3]);
    var s=res[2], e=s.totalEfforts||0, p=s.uniqueParticipants||0;
    taAnimate(eEl,e,'');
    taAnimate(rEl,taCalcRaised(e,p),'R');
  });
}

function taSwitchTab(tab){
  document.querySelectorAll('#ta-challenge .ta-tab').forEach(function(t){t.classList.remove('active');});
  document.querySelectorAll('#ta-challenge .ta-panel').forEach(function(p){p.classList.remove('active');});
  document.getElementById('ta-tab-'+tab).classList.add('active');
  document.getElementById('ta-panel-'+tab).classList.add('active');
  document.querySelectorAll('#ta-challenge .ta-panel.active .ta-row').forEach(function(r,i){
    r.style.animation='none'; r.offsetHeight;
    r.style.animation='ta-slide-in 0.3s ease '+(i*0.06)+'s both';
  });
}

function taShowConnected(athlete){
  var name=((athlete.firstname||'')+' '+(athlete.lastname||'')).trim();
  var av=document.getElementById('ta-av');
  if(athlete.profile){ av.innerHTML='<img decoding="async" src="'+athlete.profile+'" alt="'+name+'" />'; av.style.background='transparent'; }
  else { av.textContent=taInitials(athlete.firstname,athlete.lastname); av.style.background=taColor(athlete.firstname); }
  document.getElementById('ta-name').textContent=name;
  document.getElementById('ta-btn-connect').style.display='none';
  var el=document.getElementById('ta-connected'); el.style.display='flex'; el.style.animation='ta-slide-in 0.3s ease both';
}

function taDisconnect(){
  sessionStorage.removeItem(TA_SESSION_KEY);
  document.getElementById('ta-btn-connect').style.display='';
  document.getElementById('ta-connected').style.display='none';
}

function taHandleReturn(){
  var p=new URLSearchParams(window.location.search);
  var athleteParam=p.get('athlete');
  if(athleteParam){
    try{var a=JSON.parse(decodeURIComponent(athleteParam));sessionStorage.setItem(TA_SESSION_KEY,JSON.stringify(a));taShowConnected(a);}catch(e){}
    history.replaceState({},document.title,window.location.pathname); return;
  }
  if(p.get('connected')==='true'){
    var a={firstname:p.get('firstname')||'',lastname:p.get('lastname')||'',profile:p.get('profile')||''};
    sessionStorage.setItem(TA_SESSION_KEY,JSON.stringify(a)); taShowConnected(a);
    history.replaceState({},document.title,window.location.pathname); return;
  }
  if(p.get('error')) history.replaceState({},document.title,window.location.pathname);
}

function taRestoreSession(){
  try{ var s=sessionStorage.getItem(TA_SESSION_KEY); if(s) taShowConnected(JSON.parse(s)); }catch(e){}
}

document.addEventListener('DOMContentLoaded',function(){
  taCountdown();
  taHandleReturn();
  taRestoreSession();
  taFetch();
});
</script></body></html>
