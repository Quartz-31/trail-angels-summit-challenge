<html><head><style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap');

/* ── Scoped entirely under #ta-challenge to prevent WordPress theme bleed ── */
#ta-challenge *,
#ta-challenge *::before,
#ta-challenge *::after { box-sizing: border-box; margin: 0; padding: 0; }

#ta-challenge {
  --strava:     #FC4C02;
  --strava-dk:  #d93e00;
  --strava-lt:  rgba(252,76,2,0.08);
  --pink:       #E8317A;
  --pink-lt:    rgba(232,49,122,0.08);
  --pink-bd:    rgba(232,49,122,0.2);
  --red:        #CC1B1B;
  --bg:         #ffffff;
  --surface:    #f8f8f8;
  --border:     #e5e5e5;
  --border-dk:  #d0d0d0;
  --text:       #1a1a1a;
  --muted:      #777777;
  --gold:       #B8860B;
  --gold-lt:    rgba(184,134,11,0.10);
  --silver:     #7a7a7a;
  --silver-lt:  rgba(122,122,122,0.08);
  --bronze:     #8B4513;
  --bronze-lt:  rgba(139,69,19,0.08);
  --amber:      #A86800;
  --green:      #16a34a;
  --font-d:     'Barlow Condensed', sans-serif;
  --font-b:     'Barlow', sans-serif;
  --t:          0.2s ease;
  font-family:  var(--font-b);
  color:        var(--text);
  background:   var(--bg);
  line-height:  1.4;
  -webkit-font-smoothing: antialiased;
  max-width: 760px;
  margin: 0 auto;
}

/* ── Hero banner ── */
#ta-challenge .ta-hero { width: 100%; line-height: 0; margin-bottom: 0; }
#ta-challenge .ta-hero img { width: 100%; height: auto; display: block; }

/* ── Header ── */
#ta-challenge .ta-header { background: #fff; border-bottom: 1px solid var(--border); padding: 22px 20px 30px; }
#ta-challenge .ta-brand-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
#ta-challenge .ta-brand-id { display: flex; align-items: center; gap: 14px; }
#ta-challenge .ta-logo { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
#ta-challenge .ta-logo img { width: 52px; height: 52px; object-fit: contain; display: block; }
#ta-challenge .ta-brand-name { font-family: var(--font-d); font-size: 1.05rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); line-height: 1; margin-bottom: 3px; }
#ta-challenge .ta-challenge-name { font-family: var(--font-d); font-size: 1.55rem; font-weight: 900; text-transform: uppercase; letter-spacing: .03em; line-height: 1.05; color: var(--text); }
#ta-challenge .ta-challenge-name em { font-style: normal; color: var(--pink); }

/* ── Strava button — fully overriding WordPress ── */
#ta-challenge .ta-btn-strava,
#ta-challenge .ta-btn-strava:link,
#ta-challenge .ta-btn-strava:visited {
  display: inline-flex !important; align-items: center !important; gap: 9px !important;
  background: var(--strava) !important; color: #fff !important;
  border: none !important; border-radius: 6px !important; padding: 10px 18px !important;
  font-family: var(--font-b) !important; font-size: .85rem !important; font-weight: 600 !important;
  cursor: pointer !important; white-space: nowrap !important; flex-shrink: 0 !important;
  box-shadow: 0 2px 6px rgba(252,76,2,.3) !important;
  transition: background var(--t), transform var(--t), box-shadow var(--t) !important;
  text-decoration: none !important; line-height: 1 !important;
}
#ta-challenge .ta-btn-strava:hover { background: var(--strava-dk) !important; transform: translateY(-1px) !important; box-shadow: 0 4px 12px rgba(252,76,2,.35) !important; }
#ta-challenge .ta-btn-strava svg { width: 18px; height: 18px; fill: #fff; flex-shrink: 0; }
#ta-challenge .ta-btn-strava img { height: 22px; width: auto; display: block; }

#ta-challenge .ta-connected { display: none; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 8px 14px; font-size: .83rem; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
#ta-challenge .ta-connected-av { width: 32px; height: 32px; border-radius: 50%; background: var(--strava); display: flex; align-items: center; justify-content: center; font-family: var(--font-d); font-size: .8rem; font-weight: 800; color: #fff; flex-shrink: 0; overflow: hidden; }
#ta-challenge .ta-connected-av img { width: 100%; height: 100%; object-fit: cover; display: block; }
#ta-challenge .ta-connected-name { font-weight: 600; color: var(--text); font-size: .88rem; }
#ta-challenge .ta-connected-sub { color: var(--muted); font-size: .74rem; }
#ta-challenge .ta-btn-disc { background: none !important; border: none !important; color: var(--muted) !important; font-size: .75rem !important; cursor: pointer !important; text-decoration: underline !important; padding: 0 !important; transition: color var(--t) !important; box-shadow: none !important; border-radius: 0 !important; }
#ta-challenge .ta-btn-disc:hover { color: var(--strava) !important; }

/* ── How-to ── */
#ta-challenge .ta-how-to { border-top: 1px solid var(--border); padding: 22px 0 0; }
#ta-challenge .ta-how-heading { font-family: var(--font-d); font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
#ta-challenge .ta-steps { display: flex; flex-direction: column; gap: 13px; }
#ta-challenge .ta-step { display: flex; align-items: flex-start; gap: 13px; }
#ta-challenge .ta-step-n { width: 26px; height: 26px; border-radius: 50%; background: var(--pink); color: #fff; font-family: var(--font-d); font-size: .82rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
#ta-challenge .ta-step-t { font-size: .88rem; color: var(--text); line-height: 1.55; }
#ta-challenge .ta-step-t a { color: var(--strava); text-decoration: none; font-weight: 600; }
#ta-challenge .ta-step-t a:hover { text-decoration: underline; }
#ta-challenge .ta-step-t strong { color: var(--pink); font-weight: 700; }
#ta-challenge .ta-step-note { font-size: .82rem; color: var(--muted); font-style: italic; line-height: 1.5; }
#ta-challenge .ta-step-note strong { color: var(--text); font-style: normal; }

/* ── Segment bar ── */
#ta-challenge .ta-seg-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 22px 0 0; margin-top: 22px; border-top: 1px solid var(--border); flex-wrap: wrap; }
#ta-challenge .ta-seg-info { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
#ta-challenge .ta-seg-icon { width: 32px; height: 32px; background: var(--strava-lt); border: 1px solid rgba(252,76,2,.15); border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
#ta-challenge .ta-seg-icon svg { width: 16px; height: 16px; stroke: var(--strava); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
#ta-challenge .ta-seg-label { font-family: var(--font-d); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
#ta-challenge .ta-seg-name { font-family: var(--font-d); font-size: 1.05rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--text); }
#ta-challenge .ta-seg-meta { display: flex; align-items: center; gap: 8px; margin-top: 3px; flex-wrap: wrap; }
#ta-challenge .ta-seg-stat { font-size: .78rem; color: var(--muted); }
#ta-challenge .ta-seg-link { font-size: .72rem; color: var(--strava); text-decoration: none; font-weight: 600; }
#ta-challenge .ta-seg-link:hover { text-decoration: underline; }
#ta-challenge .ta-sep { color: var(--border-dk); }
#ta-challenge .ta-badge { display: inline-flex; align-items: center; gap: 5px; background: var(--pink-lt); border: 1px solid var(--pink-bd); border-radius: 20px; padding: 3px 10px; font-size: .7rem; font-weight: 600; color: var(--pink); text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
#ta-challenge .ta-badge svg { width: 9px; height: 9px; fill: var(--pink); }

/* ── Content wrapper ── */
#ta-challenge .ta-content { padding: 28px 20px 0; }

/* ── Donation banner ── */
#ta-challenge .ta-banner { background: linear-gradient(135deg,#fff5f9 0%,#fff0f6 60%,#fff 100%); border: 1px solid rgba(232,49,122,.18); border-left: 4px solid var(--pink); border-radius: 0; padding: 20px 24px; display: flex; align-items: center; gap: 20px; position: relative; overflow: hidden; box-shadow: 0 2px 12px rgba(232,49,122,.06); }
#ta-challenge .ta-banner::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at top right,rgba(232,49,122,.04) 0%,transparent 60%); pointer-events: none; }
#ta-challenge .ta-banner-content { flex: 1; position: relative; }
#ta-challenge .ta-banner-hl { font-family: var(--font-d); font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--pink); margin-bottom: 8px; }
#ta-challenge .ta-banner-stats { display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap; }
#ta-challenge .ta-banner-stat { display: flex; flex-direction: column; }
#ta-challenge .ta-stat-num { font-family: var(--font-d); font-size: 2.2rem; font-weight: 900; line-height: 1; color: var(--text); letter-spacing: .02em; }
#ta-challenge .ta-stat-num.pink { color: var(--pink); }
#ta-challenge .ta-stat-lbl { font-size: .7rem; color: var(--muted); font-weight: 500; text-transform: uppercase; letter-spacing: .05em; margin-top: 2px; }
#ta-challenge .ta-banner-div { width: 1px; height: 36px; background: var(--border); flex-shrink: 0; }
#ta-challenge .ta-banner-cause { font-size: .8rem; color: var(--muted); line-height: 1.55; max-width: 185px; position: relative; }
#ta-challenge .ta-banner-cause strong { color: var(--text); }

/* ── Month + countdown ── */
#ta-challenge .ta-month-row { margin-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
#ta-challenge .ta-month-info { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
#ta-challenge .ta-month-lbl { font-family: var(--font-d); font-size: 1.1rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: var(--text); }
#ta-challenge .ta-month-range { font-size: .78rem; color: var(--muted); font-weight: 500; }
#ta-challenge .ta-month-sep { color: var(--border-dk); font-size: .9rem; }
#ta-challenge .ta-live { display: inline-flex; align-items: center; gap: 5px; font-size: .7rem; font-weight: 600; color: var(--green); text-transform: uppercase; letter-spacing: .08em; }
#ta-challenge .ta-live::before { content: ''; width: 7px; height: 7px; background: var(--green); border-radius: 50%; animation: ta-pulse 1.8s infinite; }
@keyframes ta-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }
#ta-challenge .ta-countdown { display: flex; align-items: center; gap: 9px; }
#ta-challenge .ta-cd-num { font-family: var(--font-d); font-size: 2rem; font-weight: 900; color: var(--red); line-height: 1; }
#ta-challenge .ta-cd-txt { font-family: var(--font-d); font-size: .76rem; font-weight: 700; color: var(--red); text-transform: uppercase; letter-spacing: .07em; line-height: 1.3; }

/* ── Tabs ── */
#ta-challenge .ta-tabs-wrap { margin-top: 26px; }
#ta-challenge .ta-tabs { display: flex; border-bottom: 2px solid var(--border); gap: 0; }
#ta-challenge button.ta-tab {
  flex: 1 !important; background: #ffffff !important; border: none !important;
  border-bottom: none !important; border-radius: 0 !important; padding: 13px 16px !important;
  font-family: var(--font-d) !important; font-size: 1.05rem !important; font-weight: 800 !important;
  text-transform: uppercase !important; letter-spacing: .06em !important; color: var(--muted) !important;
  cursor: pointer !important; transition: color var(--t) !important; position: relative !important;
  display: flex !important; align-items: center !important; justify-content: center !important;
  gap: 8px !important; box-shadow: none !important; outline: none !important;
  margin: 0 !important; line-height: 1 !important;
}
#ta-challenge button.ta-tab::after {
  content: ''; position: absolute; bottom: -2px; left: 0; right: 0;
  height: 2px; background: var(--pink); transform: scaleX(0); transition: transform .25s ease;
}
#ta-challenge button.ta-tab.active { color: var(--text) !important; }
#ta-challenge button.ta-tab.active::after { transform: scaleX(1); }
#ta-challenge button.ta-tab:hover:not(.active) { color: #333 !important; background: var(--surface) !important; }

/* ── Fastest-tab bike-type toggle ── */
#ta-challenge .ta-type-toggle { display: inline-flex; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 3px; margin-bottom: 14px; gap: 2px; }
#ta-challenge button.ta-type-btn {
  background: transparent !important; border: none !important; border-radius: 16px !important;
  padding: 7px 20px !important; font-family: var(--font-b) !important; font-size: .8rem !important;
  font-weight: 600 !important; text-transform: uppercase !important; letter-spacing: .05em !important;
  color: var(--muted) !important; cursor: pointer !important;
  transition: background var(--t), color var(--t), box-shadow var(--t) !important;
  box-shadow: none !important; outline: none !important; margin: 0 !important; line-height: 1 !important;
}
#ta-challenge button.ta-type-btn.active { background: var(--pink) !important; color: #fff !important; box-shadow: 0 2px 8px rgba(232,49,122,.32) !important; }
#ta-challenge button.ta-type-btn:hover:not(.active) { color: var(--pink) !important; background: #ffffff !important; }

/* ── Leaderboard panels ── */
#ta-challenge .ta-panels { margin-top: 14px; padding-bottom: 8px; }
#ta-challenge .ta-panel { display: none; }
#ta-challenge .ta-panel.active { display: block; }
#ta-challenge .ta-lb { display: flex; flex-direction: column; gap: 6px; }

/* ── Loading / empty / error states ── */
#ta-challenge .ta-loading { text-align: center; padding: 48px 20px; color: var(--muted); }
#ta-challenge .ta-spinner { width: 30px; height: 30px; border: 3px solid var(--border); border-top-color: var(--pink); border-radius: 50%; animation: ta-spin .8s linear infinite; margin: 0 auto 14px; }
@keyframes ta-spin { to { transform: rotate(360deg); } }
#ta-challenge .ta-loading p { font-size: .88rem; }
#ta-challenge .ta-empty { text-align: center; padding: 44px 20px; color: var(--muted); border: 1px dashed var(--border); border-radius: 8px; }
#ta-challenge .ta-empty-icon { font-size: 2.2rem; margin-bottom: 10px; opacity: .45; }
#ta-challenge .ta-empty-title { font-family: var(--font-d); font-size: 1.05rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--border-dk); margin-bottom: 6px; }
#ta-challenge .ta-empty-sub { font-size: .84rem; line-height: 1.5; max-width: 380px; margin: 0 auto; }

/* ── Leaderboard rows ── */
#ta-challenge .ta-row { display: flex; align-items: center; gap: 13px; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 13px 15px; transition: background var(--t), border-color var(--t), transform var(--t), box-shadow var(--t); position: relative; overflow: hidden; }
#ta-challenge .ta-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: transparent; transition: background var(--t); }
#ta-challenge .ta-row:hover { background: var(--surface); border-color: var(--border-dk); transform: translateX(2px); box-shadow: 0 2px 10px rgba(0,0,0,.06); }
#ta-challenge .ta-row:hover::before { background: var(--pink); }
#ta-challenge .ta-row.r1 { border-color: rgba(184,134,11,.25); background: linear-gradient(90deg,var(--gold-lt) 0%,#fff 45%); box-shadow: 0 1px 6px rgba(184,134,11,.07); }
#ta-challenge .ta-row.r1::before { background: var(--gold); }
#ta-challenge .ta-row.r2 { border-color: rgba(122,122,122,.2); background: linear-gradient(90deg,var(--silver-lt) 0%,#fff 45%); }
#ta-challenge .ta-row.r2::before { background: var(--silver); }
#ta-challenge .ta-row.r3 { border-color: rgba(139,69,19,.18); background: linear-gradient(90deg,var(--bronze-lt) 0%,#fff 45%); }
#ta-challenge .ta-row.r3::before { background: var(--bronze); }
#ta-challenge .ta-rank-col { width: 38px; display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; }
#ta-challenge .ta-rank-n { font-family: var(--font-d); font-size: 1.45rem; font-weight: 900; line-height: 1; }
#ta-challenge .ta-row.r1 .ta-rank-n { color: var(--gold); }
#ta-challenge .ta-row.r2 .ta-rank-n { color: var(--silver); }
#ta-challenge .ta-row.r3 .ta-rank-n { color: var(--bronze); }
#ta-challenge .ta-row:not(.r1):not(.r2):not(.r3) .ta-rank-n { color: #c8c8c8; }
#ta-challenge .ta-jersey { width: 20px; height: 20px; flex-shrink: 0; }
#ta-challenge .ta-av { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-d); font-size: 1rem; font-weight: 800; color: #fff; flex-shrink: 0; letter-spacing: .02em; box-shadow: 0 1px 4px rgba(0,0,0,.14); overflow: hidden; }
#ta-challenge .ta-av img { width: 100%; height: 100%; object-fit: cover; display: block; }
#ta-challenge .ta-ath { flex: 1; min-width: 0; }
#ta-challenge .ta-ath-name { font-family: var(--font-d); font-size: 1.1rem; font-weight: 700; letter-spacing: .02em; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#ta-challenge .ta-ath-sub { font-size: .76rem; color: var(--amber); font-weight: 600; margin-top: 2px; }

/* ── First-timer badge ── */
#ta-challenge .ta-first-badge {
  display: inline-flex; align-items: center; gap: 4px;
  background: rgba(252,76,2,0.08); border: 1px solid rgba(252,76,2,0.2);
  border-radius: 20px; padding: 1px 7px;
  font-family: var(--font-d); font-size: .65rem; font-weight: 700;
  color: var(--strava); text-transform: uppercase; letter-spacing: .06em;
  margin-left: 6px; vertical-align: middle; white-space: nowrap;
}

#ta-challenge .ta-metric { flex-shrink: 0; text-align: right; }
#ta-challenge .ta-metric-main { font-family: var(--font-d); font-size: 1.4rem; font-weight: 900; color: var(--text); letter-spacing: .02em; line-height: 1; }
#ta-challenge .ta-row.r1 .ta-metric-main { color: var(--gold); }
#ta-challenge .ta-metric-unit { font-size: .7rem; color: var(--muted); font-weight: 500; text-transform: uppercase; letter-spacing: .06em; margin-top: 2px; text-align: right; }

/* ── Sponsor footer ── */
#ta-challenge .ta-sponsor { margin-top: 48px; border-top: 1px solid var(--border); padding: 24px 20px 8px; }
#ta-challenge .ta-sponsor-inner { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
#ta-challenge .ta-sponsor-lbl { font-family: var(--font-d); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); flex-shrink: 0; white-space: nowrap; }
#ta-challenge .ta-sponsor-rule { width: 1px; height: 26px; background: var(--border-dk); flex-shrink: 0; }
#ta-challenge .ta-sponsor-logos { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
#ta-challenge .ta-sponsor-logos img { height: 32px; width: auto; object-fit: contain; opacity: .8; transition: opacity var(--t); display: block; }
#ta-challenge .ta-sponsor-logos img:hover { opacity: 1; }

/* ── First-timer list rows ── */
#ta-challenge .ta-ft-header {
  display: flex; align-items: center; gap: 8px; padding: 14px 4px 10px;
  font-family: var(--font-d); font-size: .75rem; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  border-bottom: 1px solid var(--border); margin-bottom: 6px;
}
#ta-challenge .ta-ft-header svg { width: 18px; height: 18px; flex-shrink: 0; }
#ta-challenge .ta-ft-row {
  display: flex; align-items: center; gap: 13px; background: #fff;
  border: 1px solid var(--border); border-radius: 8px; padding: 13px 15px;
  transition: background var(--t), border-color var(--t), box-shadow var(--t);
  position: relative; overflow: hidden;
}
#ta-challenge .ta-ft-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #d8d8d8; }
#ta-challenge .ta-ft-row:hover { background: var(--surface); border-color: var(--border-dk); box-shadow: 0 2px 10px rgba(0,0,0,.05); }
#ta-challenge .ta-ft-jersey { width: 22px; height: 22px; flex-shrink: 0; }
#ta-challenge .ta-ft-ath { flex: 1; min-width: 0; }
#ta-challenge .ta-ft-name { font-family: var(--font-d); font-size: 1.1rem; font-weight: 700; letter-spacing: .02em; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#ta-challenge .ta-ft-sub { font-size: .76rem; color: var(--muted); font-weight: 500; margin-top: 2px; }
#ta-challenge .ta-ft-pill {
  flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px;
  background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
  padding: 4px 10px; font-family: var(--font-d); font-size: .72rem; font-weight: 700;
  color: var(--muted); text-transform: uppercase; letter-spacing: .05em; white-space: nowrap;
}

/* Three tabs: slightly smaller font to fit neatly */
#ta-challenge button.ta-tab { font-size: .95rem !important; }
@media (max-width: 520px) {
  #ta-challenge button.ta-tab { font-size: .78rem !important; padding: 11px 6px !important; gap: 4px !important; }
}

/* ── Animations ── */
@keyframes ta-slide-in { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
#ta-challenge .ta-row { animation: ta-slide-in .35s ease both; }
#ta-challenge .ta-row:nth-child(1){animation-delay:.05s}
#ta-challenge .ta-row:nth-child(2){animation-delay:.10s}
#ta-challenge .ta-row:nth-child(3){animation-delay:.15s}
#ta-challenge .ta-row:nth-child(4){animation-delay:.20s}
#ta-challenge .ta-row:nth-child(5){animation-delay:.25s}
#ta-challenge .ta-row:nth-child(6){animation-delay:.30s}

/* ── Mobile ── */
@media (max-width: 600px) {
