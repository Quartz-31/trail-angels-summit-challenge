@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap');

/* ── Scoped entirely under #ta-challenge to prevent WordPress theme bleed ── */
#ta-challenge *,
#ta-challenge *::before,
#ta-challenge *::after { box-sizing: border-box; margin: 0; padding: 0; }

#ta-challenge {
  --strava:     #FC4C02;
  --strava-dk:  #d93e00;
  --strava-lt:  rgba(252,76,2,0.08);
  --pink:       #E8317A;
  --pink-lt:    rgba(232,49,122,0.08);
  --pink-bd:    rgba(232,49,122,0.2);
  --red:        #CC1B1B;
  --bg:         #ffffff;
  --surface:    #f8f8f8;
  --border:     #e5e5e5;
  --border-dk:  #d0d0d0;
  --text:       #1a1a1a;
  --muted:      #777777;
  --gold:       #B8860B;
  --gold-lt:    rgba(184,134,11,0.10);
  --silver:     #7a7a7a;
  --silver-lt:  rgba(122,122,122,0.08);
  --bronze:     #8B4513;
  --bronze-lt:  rgba(139,69,19,0.08);
  --amber:      #A86800;
  --green:      #16a34a;
  --font-d:     'Barlow Condensed', sans-serif;
  --font-b:     'Barlow', sans-serif;
  --t:          0.2s ease;
  font-family:  var(--font-b);
  color:        var(--text);
  background:   var(--bg);
  line-height:  1.4;
  -webkit-font-smoothing: antialiased;
  max-width: 760px;
  margin: 0 auto;
}

/* ── Hero banner — constrained to content width ── */
#ta-challenge .ta-hero { width: 100%; line-height: 0; margin-bottom: 0; }
#ta-challenge .ta-hero img { width: 100%; height: auto; display: block; }

/* ── Header ── */
#ta-challenge .ta-header { background: #fff; border-bottom: 1px solid var(--border); padding: 22px 20px 30px; }
#ta-challenge .ta-brand-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
#ta-challenge .ta-brand-id { display: flex; align-items: center; gap: 14px; }
#ta-challenge .ta-logo { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
#ta-challenge .ta-logo img { width: 52px; height: 52px; object-fit: contain; display: block; }
#ta-challenge .ta-brand-name { font-family: var(--font-d); font-size: 1.05rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); line-height: 1; margin-bottom: 3px; }
#ta-challenge .ta-challenge-name { font-family: var(--font-d); font-size: 1.55rem; font-weight: 900; text-transform: uppercase; letter-spacing: .03em; line-height: 1.05; color: var(--text); }
#ta-challenge .ta-challenge-name em { font-style: normal; color: var(--pink); }

/* ── Strava button — fully overriding WordPress ── */
#ta-challenge .ta-btn-strava,
#ta-challenge .ta-btn-strava:link,
#ta-challenge .ta-btn-strava:visited {
  display: inline-flex !important; align-items: center !important; gap: 9px !important;
  background: var(--strava) !important; color: #fff !important;
  border: none !important; border-radius: 6px !important; padding: 10px 18px !important;
  font-family: var(--font-b) !important; font-size: .85rem !important; font-weight: 600 !important;
  cursor: pointer !important; white-space: nowrap !important; flex-shrink: 0 !important;
  box-shadow: 0 2px 6px rgba(252,76,2,.3) !important;
  transition: background var(--t), transform var(--t), box-shadow var(--t) !important;
  text-decoration: none !important; line-height: 1 !important;
}
#ta-challenge .ta-btn-strava:hover { background: var(--strava-dk) !important; transform: translateY(-1px) !important; box-shadow: 0 4px 12px rgba(252,76,2,.35) !important; }
#ta-challenge .ta-btn-strava svg { width: 18px; height: 18px; fill: #fff; flex-shrink: 0; }

#ta-challenge .ta-connected { display: none; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 8px 14px; font-size: .83rem; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
#ta-challenge .ta-connected-av { width: 32px; height: 32px; border-radius: 50%; background: var(--strava); display: flex; align-items: center; justify-content: center; font-family: var(--font-d); font-size: .8rem; font-weight: 800; color: #fff; flex-shrink: 0; overflow: hidden; }
#ta-challenge .ta-connected-av img { width: 100%; height: 100%; object-fit: cover; display: block; }
#ta-challenge .ta-connected-name { font-weight: 600; color: var(--text); font-size: .88rem; }
#ta-challenge .ta-connected-sub { color: var(--muted); font-size: .74rem; }
#ta-challenge .ta-btn-disc { background: none !important; border: none !important; color: var(--muted) !important; font-size: .75rem !important; cursor: pointer !important; text-decoration: underline !important; padding: 0 !important; transition: color var(--t) !important; box-shadow: none !important; border-radius: 0 !important; }
#ta-challenge .ta-btn-disc:hover { color: var(--strava) !important; }

/* ── How-to ── */
#ta-challenge .ta-how-to { border-top: 1px solid var(--border); padding: 22px 0 0; }
#ta-challenge .ta-how-heading { font-family: var(--font-d); font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
#ta-challenge .ta-steps { display: flex; flex-direction: column; gap: 13px; }
